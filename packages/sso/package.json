{
  "name": "@orrery/sso",
  "version": "1.7.23",
  "description": "SSO plugin for Orrery Auth",
  "type": "module",
  "license": "MIT",
  "homepage": "https://www.orrery-auth.com/docs/plugins/sso",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dxlxz/orrery-auth.git",
    "directory": "packages/sso"
  },
  "author": "Bereket Engida",
  "keywords": [
    "sso",
    "auth",
    "saml",
    "oauth",
    "oidc",
    "openid",
    "openid connect",
    "single sign on",
    "typescript",
    "orrery-auth"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint:package": "publint run --strict --pack false",
    "lint:types": "attw --profile esm-only --pack .",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest",
    "coverage": "vitest run --coverage --coverage.provider=istanbul"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "dev-source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "dev-source": "./src/client.ts",
      "types": "./dist/client.d.mts",
      "default": "./dist/client.mjs"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.mts"
      ],
      "client": [
        "./dist/client.d.mts"
      ]
    }
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "fast-xml-parser": "^5.8.0",
    "jose": "^6.2.3",
    "samlify": "^2.13.1",
    "tldts": "^7.4.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@orrery/core": "workspace:*",
    "@orrery/kysely-adapter": "workspace:*",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^5.0.6",
    "orrery-auth": "workspace:*",
    "better-call": "catalog:",
    "body-parser": "^2.3.0",
    "express": "^5.2.1",
    "kysely": "catalog:",
    "oauth2-mock-server": "^9.0.0",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "@orrery/core": "workspace:^",
    "@orrery/utils": "catalog:peer",
    "@better-fetch/fetch": "catalog:",
    "orrery-auth": "workspace:^",
    "better-call": "catalog:"
  }
}
